# Salah Admin — environment configuration
#
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# git-ignored and must never be committed.
#
# Both values are the *public* Supabase project values. They are safe to expose
# to the browser, which is exactly why RLS must be enabled on every table
# (see supabase/migrations/20260101000000_init.sql).
#
# Do NOT add a service-role key, a database password, or any other privileged
# secret to this file when deploying to a Next.js host: anything prefixed with
# NEXT_PUBLIC_ is inlined into the browser bundle.

# Project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key. Safe in the browser, security comes from RLS.
# Supabase's newer dashboards label this "Publishable key" (sb_publishable_...);
# older projects label it "anon public". Either works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
